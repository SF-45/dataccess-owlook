<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <TextArea fx:id="commandTextArea" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets left="10.0" right="10.0" />
         </BorderPane.margin>
      </TextArea>
   </center>
   <bottom>
      <BorderPane BorderPane.alignment="CENTER">
         <left>
            <VBox spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox spacing="10.0">
                     <children>
                        <RadioButton fx:id="singleExec" mnemonicParsing="false" text="Single exec">
                           <toggleGroup>
                              <ToggleGroup fx:id="execMode" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="multiExec" mnemonicParsing="false" text="Multi exec" toggleGroup="$execMode" />
                     </children>
                  </HBox>
                  <Separator />
                  <HBox spacing="10.0">
                     <children>
                        <RadioButton fx:id="cmdShell" mnemonicParsing="false" text="CMD">
                           <toggleGroup>
                              <ToggleGroup fx:id="shell" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="powershellShell" mnemonicParsing="false" text="PowerShell" toggleGroup="$shell" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </VBox>
         </left>
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
      </BorderPane>
   </bottom>
   <top>
      <TextField fx:id="title" alignment="CENTER" text="Head" BorderPane.alignment="CENTER" />
   </top>
</BorderPane>
